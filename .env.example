# Local design work needs NO .env: without VITE_SUPABASE_URL, `npm run dev` runs in
# local dev mode (fixture forum content, real public data via the /api proxy).
# Fill these in only to work against the real backend. The anon key is a public
# client key, but keep real values in .env.local, never in this file.
# Civic Spaces Supabase project
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Slice Assignment Service (services/slice-assignment/.env)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ACCOUNTS_JWKS_URL=https://kxsdzaojfaibhuzmclfq.supabase.co/auth/v1/.well-known/jwks.json
ACCOUNTS_ISSUER=https://kxsdzaojfaibhuzmclfq.supabase.co/auth/v1
ACCOUNTS_API_URL=https://accounts.empowered.vote

# Edge Function: exchange-token (set in Supabase Dashboard -> Edge Functions -> Secrets)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
ACCOUNTS_JWKS_URL=https://kxsdzaojfaibhuzmclfq.supabase.co/auth/v1/.well-known/jwks.json
ACCOUNTS_ISSUER=https://kxsdzaojfaibhuzmclfq.supabase.co/auth/v1

# Dev proxy target for /api (default: the live API). Point at a local ev-accounts:
# VITE_API_PROXY_TARGET=http://localhost:3000
